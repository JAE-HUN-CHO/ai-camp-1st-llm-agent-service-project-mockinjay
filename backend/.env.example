# MongoDB Configuration
MONGODB_ROOT_USERNAME=careguide
MONGODB_ROOT_PASSWORD=careguide_local
MONGODB_URI=mongodb://careguide:careguide_local@localhost:27017/?authSource=admin&directConnection=true

# Security
SECRET_KEY=your-secret-key-here-min-32-characters-long

# CORS Settings (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5180

# Application Settings
APP_ENV=development
DEBUG=true

PARLANT_TOOL_RESULT_MAX_PAYLOAD_KB=256
PARLANT_INIT_TIMEOUT_SECONDS=120

# Ollama Configuration
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.6:27b-mlx
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe
OLLAMA_EMBEDDING_DIMENSIONS=1536
OLLAMA_API_TIMEOUT=300
