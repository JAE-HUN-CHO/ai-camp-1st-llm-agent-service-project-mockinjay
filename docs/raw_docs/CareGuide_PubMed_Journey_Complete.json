  "data_mapping": {
    "paper_dataset_fields": {
      "title": "paper.title (string)",
      "abstract": "paper.abstract (string, 500+ chars)",
      "metadata": {
        "journal": "paper.metadata.journal (string)",
        "date": "paper.metadata.date (YYYY-MM-DD)",
        "authors": "paper.metadata.authors (array)",
        "doi": "paper.metadata.doi (string)",
        "keywords": "paper.metadata.keywords (array)",
        "citation_count": "paper.metadata.citation_count (integer)",
        "pubmed_id": "paper.metadata.pubmed_id (string)"
      }
    },
    "ui_mapping": {
      "card_title": "paper.title",
      "journal_date": "paper.metadata.journal + paper.metadata.date",
      "authors_display": "paper.metadata.authors (first 3)",
      "abstract_preview": "paper.abstract (first 200 chars)",
      "doi_display": "paper.metadata.doi",
      "pubmed_link": "https://pubmed.ncbi.nlm.nih.gov/ + paper.metadata.pubmed_id"
    }
  },

  "validation_rules": {
    "mandatory_checks": [
      "응급 키워드 최우선 감지",
      "False Negative 9개 체크 항목 모두 적용",
      "사용자 유형별 엄격한 분기",
      "연구 키워드 정확히 감지",
      "면책조항 모든 답변에 표시",
      "금지 키워드 차단",
      "비의료 주제 차단"
    ]
  },

  "parlant_import_notes": {
    "compatible": true,
    "structure": "Parlant 표준 형식",
    "nesting_depth": "2-3 levels (최적화됨)",
    "import_method": "Direct JSON import",
    "test_required": true
  },

  "ui_requirements": {
    "responsive": true,
    "breakpoints": {
      "desktop": "1200px+",
      "tablet": "768px-1199px",
      "mobile": "767px-"
    },
    "touch_optimized": true,
    "accessibility": "WCAG 2.1 AA"
  }
}
