    "priority_4_intent_classification": {
      "description": "11개 의도 분류 (AI챗봇_의도분류 시트 전체 반영)",
      "intents": {
        "INTENT_001_MEDICAL_INFO": {
          "name": "의료 정보",
          "examples": ["크레아티닌 2.1 위험해?", "GFR이 뭐야?", "사구체 여과율은 어떻게 계산해?"],
          "flow": "프로필 → 답변 (연구자: 논문 무조건, 일반인/질환자: 키워드 없으면 논문 X)",
          "response_format": "plain_text_or_paper_list",
          "kernel_required": true
        },
        "INTENT_002_DIET_INFO": {
          "name": "식단 정보",
          "examples": ["저칼륨 식단 추천해줘", "신장병에 좋은 음식", "단백질 제한 식사법"],
          "flow": "NutriCoach → 레시피 → (연구자) 논문 추천",
          "response_format": "plain_text_with_optional_papers",
          "kernel_required": false
        },
        "INTENT_003_WELFARE_INFO": {
          "name": "복지 정보",
          "examples": ["투석하면 복지 어떻게 신청해?", "신장병 환자 지원금"],
          "flow": "PDF RAG → 복지 목록 → (연구자) 논문 추천",
          "response_format": "plain_text_with_optional_papers",
          "kernel_required": true
        },
        "INTENT_004_RESEARCH": {
          "name": "연구 논문",
          "examples": ["이식 최신 연구", "만성 신장병 논문 찾아줘", "CKD treatment research"],
          "flow": "발화에 논문/연구 키워드 → PubMed 조회 → 전체 요약 메시지 + 논문 리스트",
          "response_format": "summary_message_plus_paper_list",
          "kernel_required": true
        },
        "INTENT_005_POLICY": {
          "name": "정책/응급",
          "examples": ["약 먹어도 돼?", "응급실 가야해?"],
          "flow": "응급 키워드 → 즉시 119 안내 / 약물 → 의료진 상담 권유",
          "response_format": "plain_text_urgent",
          "kernel_required": true
        },
        "INTENT_006_EMOTIONAL_SUPPORT": {
          "name": "감정 지원",
          "examples": ["투석 때문에 우울해", "병 때문에 힘들어"],
          "flow": "공감 → 실질적 조언 → 커뮤니티 추천",
          "response_format": "plain_text_empathy",
          "kernel_required": false
        },
        "INTENT_007_PROCEDURE": {
          "name": "시술/검사",
          "examples": ["생검은 어떻게 하나요?", "투석 과정 설명해줘"],
          "flow": "절차 설명 → (연구자) 논문 추천",
          "response_format": "plain_text_with_optional_papers",
          "kernel_required": false
        },
        "INTENT_008_LIFESTYLE": {
          "name": "생활 관리",
          "examples": ["운동해도 돼?", "여행 가도 괜찮아?"],
          "flow": "일반 조언 → (연구자) 논문 추천",
          "response_format": "plain_text_with_optional_papers",
          "kernel_required": false
        },
        "INTENT_009_MEDICATION": {
          "name": "약물 정보",
          "examples": ["면역억제제 부작용", "타크로리무스는 뭐야?"],
          "flow": "약물 설명 → 의료진 상담 권유 → (연구자) 논문 추천",
          "response_format": "plain_text_with_optional_papers",
