  "states": {
    "initial": "PUBMED_START",

    "PUBMED_START": {
      "id": "START",
      "type": "entry",
      "description": "PubMed Journey 시작점",
      "actions": [
        "로그인 상태 확인",
        "사용자 프로필 로드 (일반인/질환자/연구자)",
        "응급 키워드 사전 감지 활성화"
      ],
      "next": "check_emergency"
    },

    "check_emergency": {
      "id": "EMERGENCY_CHECK",
      "type": "conditional",
      "description": "응급 키워드 최우선 감지 (모든 상황에서 최우선)",
      "condition": "contains_emergency_keyword(user_input)",
      "branches": {
        "emergency_detected": {
          "condition": "True",
          "next": "emergency_response"
        },
        "no_emergency": {
          "condition": "False",
          "next": "classify_intent"
        }
      }
    },

    "emergency_response": {
      "id": "EMERGENCY_RESPONSE",
      "type": "terminal_response",
      "description": "응급 상황 즉시 안내",
      "content": "🚨 **응급 상황입니다!**\n\n즉시 119에 연락하거나 가까운 응급실로 가세요.\n\n⚠️ CareGuide는 응급 의료 서비스가 아닙니다. 생명이 위급한 상황에서는 반드시 전문 응급 의료 서비스를 이용하세요.",
      "style": {
        "background": "#FEE2E2",
        "border": "2px solid #DC2626",
        "color": "#991B1B",
        "font_size": "18px",
        "font_weight": "bold",
        "padding": "20px"
      },
      "next": "end"
    },

    "classify_intent": {
      "id": "INTENT_CLASSIFICATION",
      "type": "ai_classification",
      "description": "11개 의도 분류 (INTENT_001 ~ INTENT_011)",
      "model": "intent_classifier_v4",
      "output": "intent_id",
      "next": "route_by_intent"
    },

    "route_by_intent": {
      "id": "INTENT_ROUTING",
      "type": "conditional_router",
      "description": "의도별 응답 전략 결정",
      "branches": {
        "research_intent": {
          "condition": "intent_id == 'INTENT_004_RESEARCH' OR (user_type == 'researcher' AND has_research_keyword)",
          "description": "명시적 논문 요청 또는 연구자의 연구 키워드 포함 질문",
          "next": "detect_research_keyword"
        },
        "medical_info_simple": {
          "condition": "intent_id == 'INTENT_001_MEDICAL_INFO' AND is_simple_definition_question(user_input) AND NOT has_research_keyword",
          "description": "간단한 정의/개념 질문 (논문 키워드 없음)",
          "next": "simple_medical_answer"
        },
        "medical_info_with_papers": {
          "condition": "intent_id == 'INTENT_001_MEDICAL_INFO' AND has_research_keyword",
          "description": "의료 정보 + 연구 키워드 포함",
          "next": "detect_research_keyword"
        },
        "other_intents": {
          "condition": "intent_id IN ['INTENT_002', 'INTENT_003', 'INTENT_005', 'INTENT_006', 'INTENT_007', 'INTENT_008', 'INTENT_009', 'INTENT_010', 'INTENT_011']",
          "description": "기타 의도 (논문 필요 시 후속 추천)",
          "next": "general_answer_with_optional_papers"
        }
      }
    },

    "simple_medical_answer": {
      "id": "SIMPLE_ANSWER",
      "type": "ai_response",
      "description": "간단한 질문에 대한 Plain Text 답변 (논문 없음)",
      "template": "plain_text_template",
      "few_shot_examples": [
        {
          "input": "GFR이 뭐야?",
          "output": "GFR은 신장 여과 속도를 나타내는 지표로, 신장 기능을 평가하는 중요한 지표 중 하나입니다. GFR이 낮을수록 신장 기능이 저하되었음을 의미합니다. 일반적으로 GFR이 60 이하로 떨어지면 신장 질환의 가능성이 높아지며, 의사와 상의하여 추가적인 검사가 필요할 수 있습니다. 신장 기능에 대한 자세한 정보는 의사와 상담해보시는 것이 좋습니다. 만약 건강에 관해 걱정이 있다면 의사와 상담하는 것이 중요합니다."
        },
        {
          "input": "사구체 여과율은 어떻게 계산해?",
          "output": "사구체 여과율을 활용할 거저 사구체로 여과되는 양을 측정하는 지표로 서용합니다. 일반적으로 GFR이 낮을수록 신장 기능이 저하되었음을 의미하며, 그래이나 농도와 체중을 고려하여 공식에 따라 계산됩니다. 또한, 혈액 검사를 통해 확인할 수 있습니다. 정확한 수치 해석과 치료는 의사와 상담하는 것이 좋습니다."
        }
      ],
      "style": "conversational",
      "max_length": 300,
      "disclaimer": "⚠️ 이 정보는 참고용이며, 건강 문제는 반드시 의료진과 상담하세요.",
      "next": "end"
    },

    "general_answer_with_optional_papers": {
      "id": "GENERAL_ANSWER",
      "type": "ai_response",
      "description": "일반 답변 + 선택적 논문 추천",
      "template": "plain_text_with_optional_recommendation",
      "few_shot_examples": [
        {
          "user_type": "일반인/간병인",
          "input": "신장병이 생기면 초기 증상은 어떤가요?",
          "output": "초기에는 특별한 증상이 없는 경우가 많습니다. 피로감, 식욕부진, 가려움증 정도가 나타날 수 있고, 진행되면 부종이나 소변 변화가 생깁니다.\n\n⚠️ 증상이 있으시면 반드시 의료진 확인이 필요합니다."
        },
        {
          "user_type": "일반인/간병인",
          "input": "투석을 시작하면 일상생활 어떤 것이 불편해지나요?",
          "output": "혈액투석은 주 2-3회 병원 방문이 필요하고, 복막투석은 집에서 하루 3-4회 투석액 교환을 합니다. 투석 시간을 제외하면 일상생활은 충분히 가능합니다.\n\n⚠️ 개인의 상태에 따라 다를 수 있으니 담당 의료진과 상담하세요."
        },
        {
          "user_type": "질환자/경험자",
          "input": "이식 후 거부반응 증상은 어떻게 나타나나요?",
          "output": "급성 거부반응은 발열, 이식 부위 통증, 피로, 소변량 감소로 나타나며, 즉시 혈액검사와 생검으로 확인합니다.\n\n⚠️ 의심 증상이 있으면 즉시 병원에 연락하세요."
        },
        {
          "user_type": "질환자/경험자",
          "input": "투석과 이식을 병행할 수 있는 경우도 있나요?",
          "output": "이식 초기 적응기나 부분 거부 시 투석을 병행하며, 이식 신 기능이 안정되면 투석을 중단합니다.\n\n⚠️ 치료 계획은 담당 의료진과 상의하세요."
        }
      ],
      "smart_recommendation": {
        "enabled": true,
        "trigger": "user_type == 'patient' AND mentioned_advanced_concept",
        "bubble": "💡 혹시 {keyword}에 대한 최신 연구 결과도 궁금하신가요?"
      },
      "next": "end"
    },

    "detect_research_keyword": {
      "id": "RESEARCH_KEYWORD_CHECK",
      "type": "conditional",
      "description": "연구 키워드 감지 (논문, 연구, study, research, paper 등)",
      "keywords": ["논문", "연구", "study", "research", "paper", "journal", "publication", "최신", "트렌드", "evidence"],
      "condition": "has_research_keyword(user_input) OR user_type == 'researcher'",
      "branches": {
        "has_keyword_or_researcher": {
          "condition": "True",
          "next": "check_user_type"
        },
        "no_keyword_and_not_researcher": {
          "condition": "False",
          "next": "simple_medical_answer"
        }
      }
    },

    "check_user_type": {
      "id": "USER_TYPE_CHECK",
      "type": "conditional",
      "description": "사용자 유형별 논문 제공 권한 확인",
      "branches": {
        "researcher": {
          "condition": "user_type == 'researcher'",
          "next": "researcher_pubmed_search"
        },
        "patient": {
          "condition": "user_type == 'patient' AND (has_research_keyword OR smart_bubble_clicked)",
          "next": "patient_pubmed_search"
        },
        "general": {
          "condition": "user_type == 'general' AND has_research_keyword",
          "next": "general_pubmed_search"
        },
        "no_access": {
          "condition": "NOT (has_research_keyword OR user_type == 'researcher')",
          "next": "simple_medical_answer"
        }
      }
    },

    "researcher_pubmed_search": {
      "id": "RESEARCHER_PUBMED_SEARCH",
      "type": "api_call",
      "description": "연구자용 PubMed 검색 (최대 10편)",
      "api": "pubmed_search",
      "parameters": {
        "query": "{{user_input}}",
        "max_results": 10,
        "filters": {
          "date_range": "recent_5_years",
          "article_types": ["Clinical Trial", "Review", "Meta-Analysis", "Randomized Controlled Trial"],
          "language": "English"
        },
        "ckd_specific": {
          "mesh_terms": ["Renal Insufficiency, Chronic", "Kidney Diseases", "Kidney Transplantation", "Dialysis"],
          "exclude_retracted": true
        }
      },
      "next": "generate_summary_message_researcher"
    },

    "patient_pubmed_search": {
      "id": "PATIENT_PUBMED_SEARCH",
      "type": "api_call",
      "description": "질환자용 PubMed 검색 (최대 5편)",
      "api": "pubmed_search",
      "parameters": {
        "query": "{{user_input}}",
        "max_results": 5,
        "filters": {
          "date_range": "recent_3_years",
          "article_types": ["Clinical Trial", "Review", "Guideline"],
          "language": "English"
        },
        "ckd_specific": {
          "mesh_terms": ["Renal Insufficiency, Chronic", "Patient Care"],
          "exclude_retracted": true
        }
      },
      "next": "generate_summary_message_patient"
    },

    "general_pubmed_search": {
      "id": "GENERAL_PUBMED_SEARCH",
      "type": "api_call",
      "description": "일반인용 PubMed 검색 (최대 3편)",
      "api": "pubmed_search",
      "parameters": {
        "query": "{{user_input}}",
        "max_results": 3,
        "filters": {
          "date_range": "recent_2_years",
          "article_types": ["Review", "Guideline", "Meta-Analysis"],
          "language": "English"
        },
        "ckd_specific": {
          "mesh_terms": ["Renal Insufficiency, Chronic", "Preventive Health Services"],
          "exclude_retracted": true
        }
      },
      "next": "generate_summary_message_general"
    },

    "generate_summary_message_researcher": {
      "id": "SUMMARY_MESSAGE_RESEARCHER",
      "type": "ai_generation",
      "description": "전체 요약 메시지 생성 (연구자용 - 학술적)",
      "input": "{{search_results}}",
      "template": "summary_message_researcher_template",
      "output_variable": "summary_message",
      "next": "researcher_response_format"
    },

    "generate_summary_message_patient": {
      "id": "SUMMARY_MESSAGE_PATIENT",
      "type": "ai_generation",
      "description": "전체 요약 메시지 생성 (질환자용 - 실용적)",
      "input": "{{search_results}}",
      "template": "summary_message_patient_template",
      "output_variable": "summary_message",
      "next": "patient_response_format"
    },

    "generate_summary_message_general": {
      "id": "SUMMARY_MESSAGE_GENERAL",
      "type": "ai_generation",
      "description": "전체 요약 메시지 생성 (일반인용 - 쉬운 설명)",
      "input": "{{search_results}}",
      "template": "summary_message_general_template",
      "output_variable": "summary_message",
      "next": "general_response_format"
    },

    "researcher_response_format": {
      "id": "RESEARCHER_RESPONSE",
      "type": "formatted_response",
      "template": "researcher_paper_template",
      "next": "end"
    },

    "patient_response_format": {
      "id": "PATIENT_RESPONSE",
      "type": "formatted_response",
      "template": "patient_paper_template",
      "next": "end"
    },

    "general_response_format": {
      "id": "GENERAL_RESPONSE",
      "type": "formatted_response",
      "template": "general_paper_template",
      "next": "end"
    },

    "end": {
      "id": "END",
      "type": "terminal",
      "description": "Journey 종료"
    }
  },

  "templates": {
