# CareGuide local development configuration
MONGODB_ROOT_USERNAME=careguide
MONGODB_ROOT_PASSWORD=careguide_local
MONGODB_URI=mongodb://careguide:careguide_local@localhost:27017/?authSource=admin
MONGODB_DB_NAME=careguide

# Ollama is the only model provider. No API key is required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.6:27b-mlx
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe
OLLAMA_EMBEDDING_DIMENSIONS=1536
OLLAMA_API_TIMEOUT=300
OLLAMA_MAX_TOKENS=4096

# Local application/cache paths
PARLANT_HOME=./data/parlant
NLP_CACHE_DIR=./data/cache/nlp
EMBEDDING_CACHE_DIR=./data/cache/embedding
